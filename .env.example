# App
PORT=3000
NODE_ENV=development

# Database — matches docker-compose.yml defaults
DATABASE_URL="postgresql://investment:investment_pass@localhost:5432/investment_db"

# Redis — matches docker-compose.yml defaults
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT — replace with random 32+ char strings before running
JWT_ACCESS_SECRET=change_me_to_a_random_32_char_secret_key
JWT_REFRESH_SECRET=change_me_to_another_random_32_char_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Mock provider tuning (optional)
ACCRED_POLL_DELAY_MS=30000
KYC_POLL_DELAY_MS=30000
